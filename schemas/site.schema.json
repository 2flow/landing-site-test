{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "url": {
      "type": "string",
      "format": "uri"
    },
    "defaultLocale": {
      "type": "string",
      "minLength": 2
    },
    "locales": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string",
            "minLength": 2
          },
          "label": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "code",
          "label"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "name",
    "defaultLocale",
    "locales"
  ],
  "additionalProperties": false
}
